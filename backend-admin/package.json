{
  "name": "dxgroup-backend-v3.5",
  "version": "3.5.1",
  "description": "DXGroup Backend API v3.5.1 hardened",
  "main": "server.js",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "cron:inventory": "node cron/inventoryAlerts.js --run-now",
    "db:init": "mysql -u root < database/schema.sql && mysql -u root < database/seed.sql",
    "db:migrate-v3.4-to-3.5": "mysql -u root < database/migration-v3.4-to-v3.5.sql",
    "db:migrate-v3.5.1": "mysql -u root < database/migration-v3.5.1.sql"
  },
  "dependencies": {
    "express": "^4.19.2",
    "mysql2": "^3.11.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "multer": "^1.4.5-lts.1",
    "cloudinary": "^2.4.0",
    "nodemailer": "^6.9.14",
    "node-cron": "^3.0.3",
    "xlsx": "^0.18.5",
    "dayjs": "^1.11.12",
    "cookie-parser": "^1.4.7",
    "axios": "^1.8.4",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.4.0"
  }
}
