# ============================================================
# DXGroup · .htaccess · cPanel
# Đặt file này vào: /home/dxgroup/public_html/.htaccess
# ============================================================

Options -Indexes
Options +FollowSymLinks
RewriteEngine On

# ---- 1) Bắt buộc HTTPS + www ----
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://www.%1%{REQUEST_URI} [L,NE,R=301]

# ---- 2) Proxy /api/* → Node.js App (nếu không dùng Node.js Selector) ----
# Nếu bạn dùng cPanel → Setup Node.js App với URL = "api" → BỎ COMMENT 3 dòng dưới
# RewriteCond %{REQUEST_URI} ^/api/
# RewriteRule ^api/(.*)$ http://127.0.0.1:5000/$1 [P,L]
# ProxyPassReverse /api/ http://127.0.0.1:5000/

# ---- 3) Admin Panel → /admin/* serve từ backend-admin/public ----
# Nếu bạn build Admin vào backend-admin/public → dùng Node.js Selector là đủ
# Nếu muốn truy cập admin.dxgroup.vn → tạo subdomain trỏ vào backend-admin/public

# ---- 4) Frontend React (public_html) → SPA fallback ----
<IfModule mod_rewrite.c>
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# ---- 5) Bảo mật ----
<Files .env>
  Order allow,deny
  Deny from all
</Files>
<FilesMatch "\.(sql|log|sh|md|json)$">
  Order allow,deny
  Deny from all
</FilesMatch>

# ---- 6) Cache static ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# ---- 7) Gzip ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/javascript application/json
</IfModule>
